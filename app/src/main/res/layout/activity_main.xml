<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- タイトルバー (本家 JFrame タイトル相当) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/header_bg"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="頑張って作ったモンハンシミュレータ for MHXX"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <!-- 剣士/ガンナー (本家の絞り込み相当) -->
        <LinearLayout
            android:id="@+id/chipBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAll"
                style="@style/Widget.GanSimu.Chip.Active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="両方"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSword"
                style="@style/Widget.GanSimu.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剣士"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipGunner"
                style="@style/Widget.GanSimu.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ガンナー" />
        </LinearLayout>

        <!-- 本家タブ名そのまま -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tab_bg"
            app:tabMode="scrollable"
            app:tabIndicatorColor="@color/accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/text"
            app:tabTextColor="@color/muted"
            app:tabRippleColor="@color/primary_container"
            app:tabBackground="@color/tab_bg" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/accent" />
    </FrameLayout>
</LinearLayout>
