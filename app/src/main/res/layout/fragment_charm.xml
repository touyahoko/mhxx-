<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- カスタムお守り設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任意お守り設定"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="スキル1（系統）"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinnerSkill1"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp"
                android:popupBackground="@color/surface2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ポイント1"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/editPts1"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:inputType="numberSigned"
                android:text="0"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="スキル2（系統）"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinnerSkill2"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="6dp"
                android:popupBackground="@color/surface2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ポイント2"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <EditText
                android:id="@+id/editPts2"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:inputType="numberSigned"
                android:text="0"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="スロット数"
                android:textColor="@color/muted"
                android:textSize="12sp" />
            <Spinner
                android:id="@+id/spinnerSlots"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="10dp"
                android:popupBackground="@color/surface2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyCharm"
                    style="@style/Widget.GanSimu.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="このお守りを使用"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCharm"
                    style="@style/Widget.GanSimu.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="クリア"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCurrentCharm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:paddingTop="8dp"
                android:text="現在: お守りなし" />
        </LinearLayout>

        <!-- 穴埋め自動計算結果 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="必要お守り自動計算"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="シミュレータでスキル選択後、下のボタンで「装備＋装飾品で足りない分」を逆算します。"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:paddingBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcCharm"
                style="@style/Widget.GanSimu.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="不足分から必要お守りを計算" />

            <TextView
                android:id="@+id/txtCharmCalc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:paddingTop="10dp"
                android:text="（未計算）" />
        </LinearLayout>

        <!-- CSVお守り一覧から選ぶ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="登録済みお守り一覧（タップで選択）"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCharms"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
