<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MHXXGanSimu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface2</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:statusBarColor">@color/header_bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <style name="Widget.GanSimu.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GanSimu.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text</item>
        <item name="backgroundTint">@color/button_face</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GanSimu.Chip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text</item>
        <item name="backgroundTint">@color/button_face</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.GanSimu.Chip.Active" parent="Widget.GanSimu.Chip">
        <item name="backgroundTint">@color/accent</item>
        <item name="strokeColor">@color/accent2</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
