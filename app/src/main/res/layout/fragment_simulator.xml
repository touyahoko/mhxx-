<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="6dp">

    <!-- 上段: 条件バー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/txtStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系統"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:paddingEnd="6dp" />

            <Spinner
                android:id="@+id/spinnerSeries"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="8dp"
                android:popupBackground="@color/surface2" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="選択中のスキル: なし"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:paddingVertical="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                style="@style/Widget.GanSimu.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="検索開始"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.GanSimu.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="条件クリア"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 下段: 左スキル一覧 / 右結果 (本家の左右分割に近づける) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左: スキル一覧 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="6dp"
            android:layout_marginEnd="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="スキル選択"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="4dp"
                android:background="@color/header_bg"
                android:padding="4dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSkills"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 右: 検索結果 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="6dp"
            android:layout_marginStart="3dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="検索結果"
                android:textColor="@color/text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingBottom="4dp"
                android:background="@color/header_bg"
                android:padding="4dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/text"
                    android:fontFamily="monospace"
                    android:padding="4dp"
                    android:text="（検索結果がここに表示されます）" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
